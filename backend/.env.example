# =============================================================================
# B2B VoIP SaaS & CRM Platform — Environment Variables Template
# Copy this file to ".env" and fill in real values. Never commit the real .env.
# =============================================================================

# --- Django Core ---
SECRET_KEY=your_django_key
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,api.yourdomain.com

# --- CORS (frontend origins allowed to call this API) ---
CORS_ALLOWED_ORIGINS=http://localhost:3000,https://your-app.vercel.app

# --- Database (PostgreSQL) ---
DATABASE_URL=postgres://user:password@localhost:5432/voip_saas

# --- Redis (Celery broker + result backend) ---
REDIS_URL=redis://localhost:6379/0

# --- Telnyx (Voice, WebRTC, SMS, Number Ordering) ---
TELNYX_API_KEY=KEY...
TELNYX_PUBLIC_KEY=KEY...
TELNYX_WEBHOOK_SECRET=whsec_...
# SIP Connection ID that WebRTC telephony credentials are attached to
# (create this once in the Telnyx portal: Voice > SIP Connections).
TELNYX_CONNECTION_ID=1234567890

# --- Google Gemini (Free Tier API, used by the Agentic Lead Generation task) ---
GEMINI_API_KEY=AIzaSy...

# --- Email (monthly invoice notifications) ---
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.yourprovider.com
EMAIL_PORT=587
EMAIL_HOST_USER=billing@yourdomain.com
EMAIL_HOST_PASSWORD=your_smtp_password
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=billing@yourdomain.com

# --- Manual Billing (Bank AL Habib transfer details shown on every invoice) ---
MONTHLY_SUBSCRIPTION_AMOUNT=5000.00
BANK_NAME=Bank AL Habib
BANK_ACCOUNT_TITLE=Your Company Name
BANK_ACCOUNT_NUMBER=0000-0000000000
BANK_IBAN=PK00ABPA0000000000000000
