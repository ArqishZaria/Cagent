# =============================================================================
# B2B VoIP SaaS & CRM Platform — Environment Variables Template (Azure)
# Copy this file to ".env" and fill in real values. Never commit the real .env.
#
# Only two lines changed from the Oracle version: DATABASE_URL and (optionally)
# REDIS_URL. Nothing in backend/config/settings.py needs to change — it
# already reads dj_database_url.config(..., ssl_require=not DEBUG), which
# automatically requires SSL against Azure's Postgres in production.
# =============================================================================

# --- Django Core ---
SECRET_KEY=your_django_key
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,api.yourdomain.com

# --- CORS (frontend origins allowed to call this API) ---
CORS_ALLOWED_ORIGINS=http://localhost:3000,https://your-app.vercel.app

# --- Database (Azure Database for PostgreSQL — Flexible Server) ---
# No "sslmode=require" needed in the URL itself: settings.py's
# ssl_require=not DEBUG already forces it whenever DEBUG=False.
# Format: postgres://<user>:<password>@<server-name>.postgres.database.azure.com:5432/<db>
DATABASE_URL=postgres://voip_saas_user:password@voip-saas-pg.postgres.database.azure.com:5432/voip_saas

# --- Redis (Celery broker + result backend) ---
# Option A (default, cheapest): self-hosted Redis on the same VM — unchanged
# from Oracle setup, no TLS needed since it's local-only traffic:
REDIS_URL=redis://localhost:6379/0
#
# Option B: Azure Cache for Redis (managed). Note the "rediss://" scheme
# (double-s = TLS) and port 6380 — Azure Cache disables the plaintext 6379
# port by default. Both Celery and Django's RedisCache backend support this
# scheme natively, no code changes needed:
# REDIS_URL=rediss://:your-access-key@voip-saas-cache.redis.cache.windows.net:6380/0

# --- Telnyx (Voice, WebRTC, SMS, Number Ordering) --- (unchanged)
TELNYX_API_KEY=KEY...
TELNYX_PUBLIC_KEY=KEY...
TELNYX_WEBHOOK_SECRET=whsec_...
TELNYX_CONNECTION_ID=1234567890

# --- Google Gemini (Free Tier API) --- (unchanged)
GEMINI_API_KEY=AIzaSy...

# --- Email (wallet top-up confirmations + low-balance warnings) ---
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.yourprovider.com
EMAIL_PORT=587
EMAIL_HOST_USER=billing@yourdomain.com
EMAIL_HOST_PASSWORD=your_smtp_password
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=billing@yourdomain.com

# --- Prepaid Wallet — PayFast Raast P2M (dynamic QR top-ups) ---
# Issued when you're onboarded as a PayFast merchant. PAYFAST_API_BASE is
# their sandbox/production base URL — confirm the real one from your
# merchant dashboard before going live (placeholder below follows their
# publicly documented pattern).
PAYFAST_MERCHANT_ID=your_payfast_merchant_id
PAYFAST_SECURED_KEY=your_payfast_secured_key
PAYFAST_API_BASE=https://ipg1.apps.net.pk/api
# Must be a publicly reachable HTTPS URL PayFast can POST to — this is your
# own domain, not theirs.
PAYFAST_WEBHOOK_URL=https://api.yourdomain.com/api/wallet/webhooks/payfast/
# PayFast's Raast Dynamic QR processing fee (~0.68%), passed through to the
# tenant on top of the base PKR charge — NOT the same as cagent's own
# platform fee (that one's computed in code, not env-configured).
PAYFAST_GATEWAY_FEE_PERCENT=0.0068

# --- Live USD -> PKR exchange rate, used to price each top-up in real time ---
FX_RATE_API_URL=https://open.er-api.com/v6/latest/USD

# --- Platform owner notifications ---
# Comma-separated list — you get an email every time ANY tenant's wallet
# top-up succeeds (amount, fee breakdown, invoice number).
PLATFORM_OWNER_NOTIFICATION_EMAILS=you@yourdomain.com