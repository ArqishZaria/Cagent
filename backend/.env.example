# =============================================================================
# Cagent — B2B VoIP SaaS & CRM Platform — Environment Variables Template
# Copy to ".env" and fill in real values. Never commit the real .env.
# =============================================================================

# --- Django Core ---
SECRET_KEY=change-me-to-a-long-random-string
# Local dev: True. PRODUCTION MUST BE False (enables SSL redirect, HSTS, secure cookies).
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,api.yourdomain.com

# --- CORS (frontend origins allowed to call this API) ---
# Vite dev server runs on 5173. In production, set this to your deployed
# frontend origin(s) only — it also feeds CSRF_TRUSTED_ORIGINS when DEBUG=False.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Production example: CORS_ALLOWED_ORIGINS=https://cagent-rho.vercel.app

# Public URL of the frontend — used to build password-reset links in emails.
FRONTEND_BASE_URL=http://localhost:5173

# --- Database ---
# Local dev falls back to postgres://postgres:postgres@localhost:5432/voip_saas if unset.
# Production (Azure Database for PostgreSQL — Flexible Server), the least-privilege
# role created in deploy/README.md step 3b. SSL is forced automatically when DEBUG=False.
# Format: postgres://<user>:<password>@<server>.postgres.database.azure.com:5432/<db>
DATABASE_URL=postgres://cagent_app:password@cagent.postgres.database.azure.com:5432/cagent

# --- Redis (Celery broker + result backend + cache/rate-limit store) ---
# Option A (default): Redis on the same VM.
REDIS_URL=redis://localhost:6379/0
# Option B: Azure Cache for Redis (note rediss:// and port 6380):
# REDIS_URL=rediss://:your-access-key@voip-saas-cache.redis.cache.windows.net:6380/0

# --- Telnyx (Voice, WebRTC, SMS, Number Ordering) ---
TELNYX_API_KEY=KEY...
TELNYX_PUBLIC_KEY=KEY...
TELNYX_WEBHOOK_SECRET=whsec_...
TELNYX_CONNECTION_ID=1234567890
# Messaging Profile newly purchased numbers are attached to so they can send/receive SMS.
# If left empty, purchased numbers still work for VOICE but the SMS assignment step
# is silently skipped — texting will not work until assigned manually in the Telnyx portal.
TELNYX_MESSAGING_PROFILE_ID=

# --- Google Gemini (Prospector lead extraction) ---
GEMINI_API_KEY=AIzaSy...

# --- Email (top-up confirmations, low-balance warnings, password resets, contact form) ---
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.yourprovider.com
EMAIL_PORT=587
EMAIL_HOST_USER=billing@yourdomain.com
EMAIL_HOST_PASSWORD=your_smtp_password
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=billing@yourdomain.com
# For real delivery in production use:
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend

# --- Manual bank / SadaPay top-up instructions (shown on the Billing page) ---
MANUAL_PAYMENT_BANK_NAME=
MANUAL_PAYMENT_ACCOUNT_TITLE=
MANUAL_PAYMENT_ACCOUNT_NUMBER=
MANUAL_PAYMENT_IBAN=
MANUAL_PAYMENT_SADAPAY_NUMBER=
MANUAL_PAYMENT_INSTRUCTIONS=Transfer amount, then send a screenshot of the confirmation in the Support Chat.

# --- PayFast Raast P2M (automated top-ups — pending merchant approval) ---
PAYFAST_MERCHANT_ID=your_payfast_merchant_id
PAYFAST_SECURED_KEY=your_payfast_secured_key
PAYFAST_API_BASE=https://ipg1.apps.net.pk/api
PAYFAST_WEBHOOK_URL=https://api.yourdomain.com/api/wallet/webhooks/payfast/
PAYFAST_GATEWAY_FEE_PERCENT=0.0068

# --- Live USD -> PKR exchange rate ---
FX_RATE_API_URL=https://open.er-api.com/v6/latest/USD

# --- Platform owner notifications (comma-separated) ---
PLATFORM_OWNER_NOTIFICATION_EMAILS=you@yourdomain.com