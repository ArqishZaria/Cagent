[Unit]
Description=Celery Beat — VoIP SaaS (30-day invoice scheduler)
After=network.target redis-server.service celery-worker.service
Wants=redis-server.service

[Service]
Type=simple
User=cagentapp
Group=cagentapp
WorkingDirectory=/opt/cagent/backend
EnvironmentFile=/opt/cagent/backend/.env
ExecStart=/opt/cagent/venv/bin/celery -A config beat \
    --loglevel=info \
    --logfile=/var/log/voip-saas/celery-beat.log \
    --scheduler django_celery_beat.schedulers:DatabaseScheduler
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
