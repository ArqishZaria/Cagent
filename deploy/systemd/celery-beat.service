[Unit]
Description=Celery Beat — VoIP SaaS (30-day invoice scheduler)
After=network.target redis-server.service postgresql.service celery-worker.service
Wants=redis-server.service postgresql.service

[Service]
Type=simple
User=voipapp
Group=voipapp
WorkingDirectory=/opt/voip-saas/backend
EnvironmentFile=/opt/voip-saas/backend/.env
ExecStart=/opt/voip-saas/venv/bin/celery -A config beat \
    --loglevel=info \
    --logfile=/var/log/voip-saas/celery-beat.log \
    --scheduler django_celery_beat.schedulers:DatabaseScheduler
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
