[Unit]
Description=Celery Worker — VoIP SaaS
After=network.target redis-server.service
Wants=redis-server.service

[Service]
Type=simple
User=cagentapp
Group=cagentapp
WorkingDirectory=/opt/cagent/backend
EnvironmentFile=/opt/cagent/backend/.env
ExecStart=/opt/cagent/venv/bin/celery -A config worker \
    --loglevel=info \
    --logfile=/var/log/voip-saas/celery-worker.log \
    --concurrency=2
Restart=on-failure
RestartSec=5
KillMode=mixed
TimeoutStopSec=30

[Install]
WantedBy=multi-user.target
