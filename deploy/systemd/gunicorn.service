[Unit]
Description=Gunicorn — VoIP SaaS Django backend
After=network.target redis-server.service
Wants=redis-server.service

[Service]
Type=notify
NotifyAccess=main
User=cagentapp
Group=cagentapp
WorkingDirectory=/opt/cagent/backend
EnvironmentFile=/opt/cagent/backend/.env
ExecStart=/opt/cagent/venv/bin/gunicorn \
    config.wsgi:application \
    --bind 127.0.0.1:8000 \
    --workers 3 \
    --timeout 60 \
    --access-logfile /var/log/voip-saas/gunicorn-access.log \
    --error-logfile /var/log/voip-saas/gunicorn-error.log
ExecReload=/bin/kill -s HUP $MAINPID
KillMode=mixed
TimeoutStopSec=5
PrivateTmp=true
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
